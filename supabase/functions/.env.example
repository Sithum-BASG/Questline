# Copy to supabase/functions/.env (git-ignored) and fill in. Never commit real keys.
# fake = deterministic answers, no network (use for everything except AI-judge work and demos)
# groq = real AI judge
AI_PROVIDER=fake
GROQ_API_KEY=
GROQ_MODELS=openai/gpt-oss-120b,openai/gpt-oss-20b,qwen/qwen3.8-27b
# Optional second OpenAI-compatible provider (e.g. OpenRouter). Leave empty if unused.
AI_BACKUP_URL=
AI_BACKUP_KEY=
AI_BACKUP_MODEL=
